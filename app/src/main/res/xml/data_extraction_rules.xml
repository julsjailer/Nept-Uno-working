<?xml version="1.0" encoding="utf-8"?>
<!--
   Política conservadora de extracción de datos para Android 12+ (API 31+).
   Excluye conversaciones y memorias privadas de Room y preferencias de DataStore
   tanto del respaldo en la nube como de transferencias automáticas entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
