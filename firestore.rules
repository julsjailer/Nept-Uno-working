rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             data.languageCode is string &&
             data.languageCode in ['es', 'en', 'pt'] &&
             data.personalityId is string &&
             data.personalityId in ['analytical', 'calm_guide', 'concise', 'explorer'] &&
             data.avatarStyleId is string &&
             data.avatarStyleId in ['abyssal_core', 'tidal_pulse', 'trident_matrix'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidMemoryEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 2000 &&
             data.category is string &&
             data.category in ['PREFERENCE', 'CONTEXT', 'WORKFLOW', 'GENERAL'] &&
             data.authorizedByUser is bool &&
             data.authorizedByUser == true &&
             (!('localId' in data) || (data.localId is int && data.localId >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidConversation(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.messageCount is int &&
             data.messageCount >= 0 &&
             data.messageCount <= 50000 &&
             (!('localId' in data) || (data.localId is int && data.localId >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId, conversationId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.conversationId is string &&
             data.conversationId == conversationId &&
             data.conversationId.size() <= 128 &&
             data.sender is string &&
             data.sender in ['USER', 'ASSISTANT', 'SYSTEM_NOTICE'] &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 16000 &&
             data.interrupted is bool &&
             (!('providerId' in data) || (data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 80)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'languageCode', 'personalityId', 'avatarStyleId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'languageCode', 'personalityId', 'avatarStyleId', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'languageCode', 'personalityId', 'avatarStyleId', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'authorizedByUser', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'authorizedByUser', 'localId', 'createdAt', 'updatedAt']) &&
                         isValidMemoryEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'localId', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().keys().hasAll(['userId', 'title', 'messageCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'messageCount', 'localId', 'createdAt', 'updatedAt']) &&
                         isValidConversation(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messageCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(conversationId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll(['userId', 'conversationId', 'sender', 'content', 'interrupted', 'createdAt', 'updatedAt']) &&
                           incoming().keys().hasOnly(['userId', 'conversationId', 'sender', 'content', 'interrupted', 'providerId', 'createdAt', 'updatedAt']) &&
                           isValidChatMessage(incoming(), userId, conversationId) &&
                           (exists(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)) ||
                            existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)));

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }
    }
  }
}
